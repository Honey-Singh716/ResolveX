# ============================================================
# ResolveX — .gitignore
# ============================================================

# ── Python virtual environments ───────────────────────────
backend/.venv/
.venv/
venv/

# ── Python generated files ────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── Frontend dependencies & build output ──────────────────
frontend/node_modules/
node_modules/
frontend/dist/
dist/
coverage/
.vite/
frontend/.vite/
.vitest/
frontend/.vitest/
*.tsbuildinfo

# ── Local databases & runtime files ──────────────────────
*.sqlite
*.sqlite3
*.db
*.log
logs/

# ── Environment files & secrets ──────────────────────────
# NEVER commit real .env files — they contain passwords and keys.
.env
.env.*
backend/.env
frontend/.env

# Allow example/template env files (safe to commit — no real secrets)
!.env.example
!.env.*.example
!backend/.env.example
!frontend/.env.example

# ── OS & editor files ─────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.suo
*.user

# ── Temporary files ───────────────────────────────────────
*.tmp
*.temp
