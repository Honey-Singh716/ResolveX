# ============================================================
# ResolveX Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- Database ---
# PostgreSQL connection string. Use the psycopg3 driver format.
# Example (Neon / Supabase PostgreSQL):
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- Security ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Access token lifetime in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slash).
# Leave blank to allow localhost origins only (development mode).
# Example: https://resolvex.vercel.app,https://www.resolvex.app
ALLOWED_ORIGINS=

# --- Platform Administrator Bootstrap ---
# These are used ONCE on startup to create the platform admin account.
# Remove or leave blank after the first successful deploy.
PLATFORM_ADMIN_EMAIL=admin@yourdomain.com
PLATFORM_ADMIN_PASSWORD=ChangeThisBeforeDeploying!
PLATFORM_ADMIN_ALLOWED_DOMAIN=yourdomain.com

# --- App Metadata (optional) ---
ENVIRONMENT=production